# Biconomy API Key
# Get from https://dashboard.biconomy.io
EXPO_PUBLIC_BICONOMY_API_KEY=your_biconomy_api_key_here

# WalletConnect Project ID
# Get from https://cloud.walletconnect.com
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Environment (development or production)
ENV=development

# Deposit Address (optional, defaults to dev address)
EXPO_PUBLIC_DEPOSIT_ADDRESS=0x0cBeE0516372F55dcff5a1299AD37498F54c30C8
